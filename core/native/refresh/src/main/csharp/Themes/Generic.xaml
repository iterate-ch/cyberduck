<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ch.Cyberduck.Core.Refresh.Controls">

    <ControlTemplate x:Key="DefaultDialogContentControl"
                     TargetType="{x:Type local:DialogContentControl}">
        <HeaderedContentControl Style="{DynamicResource TitledTabStyle}">
            <HeaderedContentControl.Header>
                <Grid Margin="{DynamicResource ControlItemNegativeSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Source="{TemplateBinding ImageSource}"
                           VerticalAlignment="Top"
                           Width="48"
                           Height="48"
                           Margin="{DynamicResource ControlItemSpacing}"
                           Grid.Column="0" />

                    <ContentPresenter ContentSource="Header"
                                      Margin="{DynamicResource ControlItemSpacing}"
                                      Grid.Column="1" />
                </Grid>
            </HeaderedContentControl.Header>

            <Grid Margin="{DynamicResource CardItemNegativeSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentPresenter ContentSource="Content"
                                  x:Name="PART_Content"
                                  Margin="{DynamicResource CardItemSpacing}"
                                  Grid.Row="0" />

                <Border Style="{DynamicResource DialogBorderStyle}"
                        Margin="{DynamicResource CardItemSpacing}"
                        Grid.Row="1">
                    <ContentPresenter ContentSource="DialogContent" />
                </Border>
            </Grid>
        </HeaderedContentControl>

        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Content,RelativeSource={RelativeSource Self}}"
                         Value="{x:Null}">
                <Setter TargetName="PART_Content"
                        Property="Visibility"
                        Value="Collapsed" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:DialogContentControl}">
        <Setter Property="Template"
                Value="{StaticResource DefaultDialogContentControl}" />
    </Style>
</ResourceDictionary>
