<UserControl x:Class="Ch.Cyberduck.Core.Refresh.Views.MetadataInfoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:vm="clr-namespace:Ch.Cyberduck.Core.Refresh.ViewModels.Info"
             xmlns:local="clr-namespace:Ch.Cyberduck.Core.Refresh.Views"
             xmlns:xaml="clr-namespace:Ch.Cyberduck.Core.Refresh.Xaml"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MetadataViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{xaml:Text 'Headers',Table=Info}"
                   x:Name="HeadersTitle"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="{StaticResource CardSpacing}"
                   Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="VersionGrid"
                      ItemsSource="{Binding Metadata}"
                      AutoGenerateColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AutomationProperties.LabeledBy="{Binding ElementName=HeadersTitle}"
                      Grid.Row="0">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="KeyColumn"
                                        Header="{xaml:Text Name, Table=Info}"
                                        Binding="{Binding Key}"
                                        ElementStyle="{StaticResource DataGridTextColumnElementAppStyle}"
                                        EditingElementStyle="{StaticResource DataGridTextColumnEditingElementAppStyle}"
                                        Width="*" />
                    <DataGridTextColumn x:Name="ValueColumn"
                                        Header="{xaml:Text Value, Table=Info}"
                                        Binding="{Binding Display}"
                                        ElementStyle="{StaticResource DataGridTextColumnElementAppStyle}"
                                        EditingElementStyle="{StaticResource DataGridTextColumnEditingElementAppStyle}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Menu Style="{StaticResource DialogMenuStyle}"
                  Grid.Row="1">
                <MenuItem x:Name="AddNewMetadataButton"
                          ItemsSource="{Binding MetadataMenuItems}"
                          AutomationProperties.Name="{xaml:Text 'Custom Header',Table=S3}">
                    <MenuItem.Header>
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE710;" />
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
        </Grid>

        <tk:BusyIndicator x:Name="Status"
                          IsBusy="{Binding Busy}"
                          BusyContent="{x:Null}"
                          Grid.RowSpan="2" />
    </Grid>
</UserControl>
