<local:ProfilesPageBase x:Class="Ch.Cyberduck.Core.Refresh.Views.ProfilesPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:sys="clr-namespace:System;assembly=mscorlib"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                        xmlns:local="clr-namespace:Ch.Cyberduck.Core.Refresh.Views"
                        xmlns:vm="clr-namespace:Ch.Cyberduck.Core.Refresh.ViewModels.Preferences.Pages"
                        xmlns:viewServices="clr-namespace:Ch.Cyberduck.Core.Refresh.Views.Services"
                        xmlns:xaml="clr-namespace:Ch.Cyberduck.Core.Refresh.Xaml"
                        mc:Ignorable="d"
                        d:DesignHeight="450"
                        d:DesignWidth="800">
    <local:ProfilesPageBase.Resources>
        <sys:Int32 x:Key="ThumbnailSize">32</sys:Int32>
        <viewServices:ProfileDescriptionThumbnailConverter x:Key="ProfileThumbnails" />
    </local:ProfilesPageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageTitleCardItemCompactItemSpacing}"
                    Grid.Row="0">
            <TextBlock Text="{xaml:Text 'Connection Profiles',Table=Profiles}"
                       Focusable="True"
                       x:Name="ConnectionProfilesTitle"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource CompactItemSpacing}" />
            <TextBlock Text="{xaml:Text 'Install additional connection profiles from different service providers.',Table=Profiles}"
                       x:Name="TitleDescription"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="{StaticResource CompactItemSpacing}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Grid.Row="0"
                        Margin="{StaticResource ControlCompactItemSpacing}">
                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                           Text="&#xE721;"
                           VerticalAlignment="Center"
                           Margin="{StaticResource CompactItemSpacing}" />

                <TextBox Name="Search"
                         Width="260"
                         Margin="{StaticResource CompactItemSpacing}"
                         AutomationProperties.Name="{xaml:Text 'Search…',Table=Main}" />
            </StackPanel>

            <DataGrid x:Name="profilesList"
                      AutoGenerateColumns="False"
                      HeadersVisibility="None"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VerticalGridLinesBrush="{x:Null}"
                      AutomationProperties.LabeledBy="{Binding ElementName=ConnectionProfilesTitle}"
                      AutomationProperties.HelpText="{Binding Text,ElementName=TitleDescription}"
                      Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Installed}"
                                            Width="32">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin"
                                        Value="{StaticResource UIItemSpacing}" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                                <Setter Property="IsEnabled"
                                        Value="{Binding Enabled}" />
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Focusable"
                                        Value="False" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ProfileViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ProfileDescription,Converter={StaticResource ProfileThumbnails},ConverterParameter={StaticResource ThumbnailSize}}"
                                           Margin="{StaticResource UIItemSpacing}"
                                           Grid.Column="0" />

                                    <StackPanel Margin="{StaticResource UIItemSpacing}"
                                                Grid.Column="1">
                                        <TextBlock Text="{Binding Description}"
                                                   x:Name="Description"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding Name}"
                                                   x:Name="ProtocolType"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="54">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ProfileViewModel">
                                <Button Command="{Binding OpenHelp}"
                                        HorizontalAlignment="Center"
                                        Margin="{StaticResource UIItemSpacing}"
                                        AutomationProperties.Name="{xaml:Text Help,Table=Support}">
                                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               Text="&#xE897;"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <xctk:BusyIndicator x:Name="Status"
                            BusyContent="{x:Null}"
                            Grid.RowSpan="2" />
    </Grid>
</local:ProfilesPageBase>
